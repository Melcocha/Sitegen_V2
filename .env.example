# SiteGen AI — Environment Variables
# Copy this to .env.local and fill in your keys.
# NEVER commit .env.local to git.

# ── Supabase ──────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://vcigliertaoqrdawhsah.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── OpenAI ────────────────────────────────────────────────────────
# Leave empty → DEMO MODE (rich mock data, no API cost)
VITE_OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────────
# STRIPE — Payment Processing
# HOW TO GO LIVE:
#   1. Create products + prices in Stripe Dashboard
#   2. Fill each VITE_STRIPE_* var below with the real IDs
#   3. Set VITE_STRIPE_PUBLISHABLE_KEY → payment mode switches automatically
#   4. Deploy the two Edge Functions in supabase/functions/
#   5. Configure the webhook endpoint in Stripe → pointing to:
#      https://vcigliertaoqrdawhsah.supabase.co/functions/v1/stripe-webhook
#
# While VITE_STRIPE_PUBLISHABLE_KEY is empty → SIMULATED MODE (no Stripe)
# ─────────────────────────────────────────────────────────────────

# Publishable key (safe to expose in frontend)
# Leave EMPTY for simulated mode during development
VITE_STRIPE_PUBLISHABLE_KEY=

# Stripe Price IDs — one per plan × billing cycle
VITE_STRIPE_STARTER_MONTHLY=price_starter_monthly_here
VITE_STRIPE_STARTER_ANNUAL=price_starter_annual_here
VITE_STRIPE_PRO_MONTHLY=price_pro_monthly_here
VITE_STRIPE_PRO_ANNUAL=price_pro_annual_here
VITE_STRIPE_AGENCY_MONTHLY=price_agency_monthly_here
VITE_STRIPE_AGENCY_ANNUAL=price_agency_annual_here

# ── Vercel API (for publishing websites to Vercel) ────────────────
# Personal Access Token: https://vercel.com/account/tokens
VITE_VERCEL_TOKEN=your_vercel_token_here
VITE_VERCEL_TEAM_ID=your_team_id_here

# ── App URL ───────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173
